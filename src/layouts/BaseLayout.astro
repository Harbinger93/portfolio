---
import "../styles/global.css";
import GlowBackground from "../components/ui/GlowBackground";
import Navbar from "../components/layout/Navbar";
import Footer from "../components/layout/Footer";
import ProtectionLayer from "../components/security/ProtectionLayer";
import LenisProvider from "../components/layout/LenisProvider";
import ScrollToTop from "../components/ui/ScrollToTop";
import WhatsAppBubble from "../components/ui/WhatsAppBubble";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gabriel Vazquez | Ingeniero Informático & Coach Ontológico. Portafolio profesional de desarrollo web, SEO, y coaching ontológico." />
    <meta name="keywords" content="desarrollador web, coach ontológico, wordpress, SEO, venezuela, portafolio" />
    <meta name="author" content="Gabriel Vazquez" />
    <meta property="og:title" content="Gabriel Vazquez | Desarrollador Web & Coach Ontológico" />
    <meta property="og:description" content="Desarrollador front-end con 7+ años creando ecosistemas digitales de alto impacto." />
    <meta property="og:type" content="website" />
    <link rel="stylesheet" href="/fonts/inter.css" />
    <title>Gabriel Vazquez | Desarrollador Web front-end</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      if (savedTheme === "light") {
        document.documentElement.classList.add("light");
      } else if (savedTheme === "dark") {
        // do nothing, dark is default
      } else if (
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: light)").matches
      ) {
        document.documentElement.classList.add("light");
      }
    </script>
  </head>
  <body class="antialiased">
    <GlowBackground client:only="react" />
    <LenisProvider client:only="react">
      <Navbar client:only="react" />
      <main>
        <slot />
      </main>
      <Footer client:only="react" />
    </LenisProvider>
    <ProtectionLayer client:only="react" />
    <ScrollToTop client:only="react" />
    <WhatsAppBubble client:only="react" />
  </body>
</html>
