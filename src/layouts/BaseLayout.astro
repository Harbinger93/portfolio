---
import { pwaInfo } from 'virtual:pwa-info';
import "../styles/global.css";
import GlowBackground from "../components/ui/GlowBackground";
import Navbar from "../components/layout/Navbar";
import Footer from "../components/layout/Footer";
import ProtectionLayer from "../components/security/ProtectionLayer";
import LenisProvider from "../components/layout/LenisProvider";
import ScrollToTop from "../components/ui/ScrollToTop";
import WhatsAppBubble from "../components/ui/WhatsAppBubble";
import ToolsLaunchpad from "../components/layout/ToolsLaunchpad";
import { ViewTransitions } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

const { noindex = false } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="description" content="Gabriel Vazquez | Ingeniero Informático & Coach Ontológico. Portafolio profesional de desarrollo web, SEO, y coaching ontológico." />
    <meta name="keywords" content="desarrollador web, coach ontológico, wordpress, SEO, venezuela, portafolio" />
    <meta name="author" content="Gabriel Vazquez" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://gabrielvazquez.dev/" />
    <meta property="og:title" content="Gabriel Vazquez | Desarrollador Web & Coach Ontológico" />
    <meta property="og:description" content="Desarrollador front-end con 7+ años creando ecosistemas digitales de alto impacto." />
    <meta property="og:image" content="https://gabrielvazquez.dev/avatar.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://gabrielvazquez.dev/" />
    <meta name="twitter:title" content="Gabriel Vazquez | Desarrollador Web & Coach Ontológico" />
    <meta name="twitter:description" content="Desarrollador front-end con 7+ años creando ecosistemas digitales de alto impacto." />
    <meta name="twitter:image" content="https://gabrielvazquez.dev/avatar.webp" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
    <meta name="theme-color" content="#050505" />
    {isHome && (
      <>
        <link rel="preload" href="/avatar-mobile.webp" as="image" type="image/webp" fetchpriority="high" media="(max-width: 768px)" />
        <link rel="preload" href="/avatar.webp" as="image" type="image/webp" fetchpriority="high" media="(min-width: 769px)" />
      </>
    )}
    <link rel="preload" href="/avatar-nav.webp" as="image" type="image/webp" />
    <link rel="preload" href="/fonts/inter-weight-7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-weight-14.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* latin 400 */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url(/fonts/inter-weight-7.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* latin 700 */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url(/fonts/inter-weight-14.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* latin 800 */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 800;
        font-display: swap;
        src: url(/fonts/inter-weight-21.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      /* latin 900 */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 900;
        font-display: swap;
        src: url(/fonts/inter-weight-28.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>
    <title>Gabriel Vazquez | Desarrollador Web front-end</title>
    <!-- Google tag (gtag.js) - Deferred loading to prioritize FCP/LCP -->
    <script is:inline>
      const loadGA = () => {
        if (window.gaLoaded) return;
        window.gaLoaded = true;
        
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-Y4KY950MXL';
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-Y4KY950MXL');
      };

      if (document.readyState === 'complete') {
        setTimeout(loadGA, 1000);
      } else {
        window.addEventListener('load', () => setTimeout(loadGA, 1000));
      }
    </script>
    <script is:inline>
      const applyTheme = () => {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light") {
          document.documentElement.classList.add("light");
        } else {
          document.documentElement.classList.remove("light");
        }
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
      
      // Prevent theme flashing during Astro view transitions
      document.addEventListener("astro:before-swap", (e) => {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme === "light") {
          e.newDocument.documentElement.classList.add("light");
        } else {
          e.newDocument.documentElement.classList.remove("light");
        }
      });
    </script>
  </head>
  <body class="antialiased">
    <GlowBackground transition:persist />
    <LenisProvider client:only="react" />
    <Navbar client:load transition:persist />
    <main>
      <slot />
    </main>
    <Footer client:visible />
    <ProtectionLayer client:idle />
    <ScrollToTop client:idle />
    <WhatsAppBubble client:idle />
    <ToolsLaunchpad client:idle />
    <Analytics />
  </body>
</html>
